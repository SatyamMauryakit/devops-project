# bootstrap/terraform.tfvars.example
#
# Copy this file to terraform.tfvars and fill in real values.
# Never commit terraform.tfvars.
#
# S3 bucket names are globally unique. A reliable pattern:
#   "<project>-tfstate-<your-aws-account-id>"
# Replace 123456789012 with your actual AWS account ID.

aws_region        = "us-east-1"
project           = "devops-sentinel"
environment       = "shared"
state_bucket_name = "devops-sentinel-tfstate-123456789012"
lock_table_name   = "devops-sentinel-tflock"
