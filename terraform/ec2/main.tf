# main.tf

data "aws_vpc" "default" {
  default = true
}

data "aws_ami" "amazon_linux" {
  most_recent = true
  owners      = ["amazon"]

  filter {
    name   = "name"
    values = ["al2023-ami-*-x86_64"]
  }

  filter {
    name   = "state"
    values = ["available"]
  }
}

# ---------------------------------------------------------------------------
# SSH key pair — generated by Terraform so no manual `aws ec2 create-key-pair`
# step is needed. The private key is emitted as a sensitive output; see
# outputs.tf and the README for how to save it to a .pem file.
# ---------------------------------------------------------------------------
resource "tls_private_key" "deploy" {
  algorithm = "RSA"
  rsa_bits  = 4096
}

resource "aws_key_pair" "deploy" {
  key_name   = "devops-sentinel-deploy"
  public_key = tls_private_key.deploy.public_key_openssh
}

# ---------------------------------------------------------------------------
# Security group: SSH restricted to your IP, HTTP open to the world.
# ---------------------------------------------------------------------------
resource "aws_security_group" "app" {
  name        = "devops-sentinel-ec2-sg"
  description = "DevOps Sentinel EC2 security group"
  vpc_id      = data.aws_vpc.default.id

  ingress {
    description = "SSH from your IP only"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.allowed_ssh_cidr]
  }

  ingress {
    description = "HTTP from anywhere"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

# ---------------------------------------------------------------------------
# EC2 instance
# ---------------------------------------------------------------------------
resource "aws_instance" "app" {
  ami                    = data.aws_ami.amazon_linux.id
  instance_type          = var.instance_type
  key_name               = aws_key_pair.deploy.key_name
  vpc_security_group_ids = [aws_security_group.app.id]

  # Default AL2023 root volume (8GB) is not enough: OS updates + Docker +
  # npm/go build layers routinely exceed it, failing the build mid-way
  # with "No space left on device". 24GB comfortably covers it.
  root_block_device {
    volume_size = 24
    volume_type = "gp3"
  }

  user_data = templatefile("${path.module}/user_data.sh.tpl", {
    github_repo_url      = var.github_repo_url
    mongo_root_username  = var.mongo_root_username
    mongo_root_password  = var.mongo_root_password
  })

  # Changing the clone URL or Mongo credentials should re-provision the
  # instance (re-run user_data) rather than silently drift.
  user_data_replace_on_change = true

  tags = {
    Name = "devops-sentinel"
  }
}
