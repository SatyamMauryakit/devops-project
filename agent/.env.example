# agent/.env.example
# Copy to agent/.env for local development. Never commit .env.

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
PORT=8081
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Temporal
# ---------------------------------------------------------------------------
TEMPORAL_ADDR=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=sentinel-incidents

# ---------------------------------------------------------------------------
# Observability data sources
# ---------------------------------------------------------------------------
LOKI_URL=http://localhost:3100
PROMETHEUS_URL=http://localhost:9090

# ---------------------------------------------------------------------------
# LLM provider: "ollama" or "groq"
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama

# Ollama settings (used when LLM_PROVIDER=ollama)
# Run locally: docker run -p 11434:11434 ollama/ollama:0.3.6
# Then: docker exec <container> ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Groq settings (used when LLM_PROVIDER=groq)
# Free tier: https://console.groq.com — 6000 req/day on llama3-8b-8192
# Token goes in a Kubernetes Secret; never hardcode it here.
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama3-8b-8192

# ---------------------------------------------------------------------------
# OpenTelemetry
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=devops-sentinel-agent

# ---------------------------------------------------------------------------
# Slack / WhatsApp (same as Step 6 notifier)
# Only needed if the agent sends its own notifications (fallback path).
# Primary notifications go through the Temporal workflow activities.
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL=REPLACE_WITH_YOUR_SLACK_INCOMING_WEBHOOK_URL
