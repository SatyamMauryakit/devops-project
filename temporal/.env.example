# temporal/.env.example
# Copy to temporal/.env and fill in real values.
# Never commit temporal/.env.
#
# These credentials are used only by the local Temporal Postgres container.
# They are not shared with the application database.

POSTGRES_USER=temporal
POSTGRES_PASSWORD=temporal_secret
POSTGRES_DB=temporal

# Temporal server binds to this host for the worker and Web UI to connect to.
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233

# Loki and Prometheus endpoints that the worker activities will call.
# Change these if you are running the observability stack on different ports.
LOKI_URL=http://localhost:3100
PROMETHEUS_URL=http://localhost:9090

# Slack webhook URL used by the notify activity.
# Same as the SLACK_WEBHOOK_URL secret used in Step 6.
SLACK_WEBHOOK_URL=REPLACE_WITH_YOUR_SLACK_INCOMING_WEBHOOK_URL

# WhatsApp Cloud API credentials used by the notify activity.
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_RECIPIENT_NUMBER=+12025550123
WHATSAPP_TEMPLATE_NAME=sentinel_alert
WHATSAPP_TEMPLATE_LANG=en_US
