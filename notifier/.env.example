# notifier/.env.example
# Copy to notifier/.env for local development.
# Never commit .env.

# ---------------------------------------------------------------------------
# Slack
# ---------------------------------------------------------------------------
# Incoming Webhook URL from your Slack App configuration.
# Create at: https://api.slack.com/apps -> Your App -> Incoming Webhooks
SLACK_WEBHOOK_URL=REPLACE_WITH_YOUR_SLACK_INCOMING_WEBHOOK_URL

# ---------------------------------------------------------------------------
# WhatsApp (Meta Cloud API)
# ---------------------------------------------------------------------------
# Temporary access token from Meta developer console.
# Test tokens expire every 24 hours.
# For persistent access, create a System User in Meta Business Manager
# and generate a permanent token with whatsapp_business_messaging permission.
WHATSAPP_ACCESS_TOKEN=your-meta-access-token-here

# The Phone Number ID of the FROM number (not the phone number itself).
# Found in: Meta Developer Console -> Your App -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# The TO phone number in E.164 format. Must be a verified test recipient
# in the Meta developer console for the test number.
WHATSAPP_RECIPIENT_NUMBER=+12025550123

# Name of the pre-approved message template.
# Create at: Meta Business Manager -> WhatsApp Manager -> Message Templates
WHATSAPP_TEMPLATE_NAME=sentinel_alert

# BCP-47 language code matching the template language.
WHATSAPP_TEMPLATE_LANG=en_US

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8080
LOG_LEVEL=info
